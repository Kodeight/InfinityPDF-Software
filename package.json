{
  "name": "infinitypdf",
  "version": "1.3.0",
  "main": "public/electron.js",
  "description": "Professional Document Management Suite",
  "author": "Abdelhalim K.",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run react-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "react-dev": "react-scripts start",
    "build": "react-scripts build",
    "build:backend": "pyinstaller --name InfinityPDF-backend --onefile --distpath backend-dist backend.py",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dist": "npm run build && npm run build:backend && electron-builder"
  },
  "homepage": "./",
  "dependencies": {
    "@google/genai": "^1.38.0",
    "electron-store": "^8.1.1",
    "fs-extra": "^11.1.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.0",
    "electron": "^25.0.0",
    "electron-builder": "^26.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "typescript": "^4.9.5",
    "wait-on": "^7.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.infinitypdf.app",
    "productName": "InfinityPDF",
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "extraResources": [
      {
        "from": "backend-dist/InfinityPDF-backend.exe",
        "to": "InfinityPDF-backend.exe"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "main/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon/android-chrome-512x512.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "installerHeaderIcon": "public/favicon.ico"
    },
    "asar": true
  }
}
